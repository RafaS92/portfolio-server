# Copy this file to .env.production when you are ready to configure hosting.
# It is a template only and does not deploy or modify external services.
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=https://www.rafaelsvaldez.com
JSON_BODY_LIMIT=32kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
CHAT_REQUEST_TIMEOUT_MS=25000
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000

OPENAI_API_KEY=replace_with_production_openai_key
OPENAI_MODEL=gpt-4o-mini

PINECONE_API_KEY=replace_with_production_pinecone_key
PINECONE_INDEX=rafa-portfolio
PINECONE_NAMESPACE=production-v1

# Optional path used only when running the local release-readiness command.
# RELEASE_FRONTEND_DIR=/absolute/path/to/portfolio-frontend
