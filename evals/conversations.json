    {
      "id": "load-balancer-follow-up-en",
      "scenario": "A project question followed by pronoun-based technical questions",
      "turns": [
        {
          "locale": "en",
          "message": "Tell me about the Load Balancer project.",
          "expectedSourceIds": ["loadbalancer-overview-en"],
          "requiredConcepts": [
            { "label": "project", "anyOf": ["load balancer"] },
            { "label": "stack", "anyOf": ["Python", "Nginx"] }
          ],
          "expectsFallback": false
        },
        {
          "locale": "en",
          "message": "What routing strategies does it use?",
          "expectedSourceIds": ["loadbalancer-overview-en"],
          "requiredConcepts": [
            { "label": "round robin", "anyOf": ["round-robin", "round robin"] },
            { "label": "least connections", "anyOf": ["least-connections", "least connections"] }
          ],
          "expectsFallback": false
        },
        {
          "locale": "en",
          "message": "How does it handle failures?",
          "expectedSourceIds": ["loadbalancer-overview-en"],
          "requiredConcepts": [
            { "label": "health checks", "anyOf": ["health checks"] },
            { "label": "failure handling", "anyOf": ["safe retries", "failure isolation"] }
          ],
          "expectsFallback": false
        }
      ]
    },
