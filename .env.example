# HTTP server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://www.rafaelsvaldez.com
JSON_BODY_LIMIT=32kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
CHAT_REQUEST_TIMEOUT_MS=25000
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Optional model used only by npm run evals:answers:judge
OPENAI_EVAL_MODEL=gpt-4o-mini

# Optional groundedness-evaluation thresholds
EVAL_MIN_JUDGE_PASS_RATE=0.8
EVAL_MIN_GROUNDEDNESS=3
EVAL_MIN_CORRECTNESS=3
EVAL_MIN_RELEVANCE=3
EVAL_MIN_COMPLETENESS=2
EVAL_MIN_CONVERSATION_TURN_PASS_RATE=0.9

# Supabase (temporary: required only by the retained legacy endpoints)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your_supabase_api_key

# Pinecone (used by the RAG v2 ingestion, search, and evaluation commands)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=rafa-portfolio
PINECONE_NAMESPACE=development-v1

# Optional release-check integration with the separate frontend repository
# RELEASE_FRONTEND_DIR=/absolute/path/to/portfolio-frontend
# RELEASE_ENV_FILE=.env.production
